# Copy to .env (git-ignored). Loaded automatically at startup by both the
# server and `make seed`; variables already set in the real environment
# always take precedence over this file.

# Server
PORT=3000
NODE_ENV=development

# Direct Postgres access as the least-privilege app_backend_v2 role
# (database/backend_v2_role.sql). Use the Supavisor pooler connection string,
# transaction mode recommended -- see plans/backend-go-migration.md §3.
DATABASE_URL=postgresql://app_backend_v2:password@your-project-pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project. SUPABASE_URL is required (JWKS verification + Auth API
# proxying). The anon key is used for signup/login/OTP/refresh; the
# service-role key only for confirm-reset's admin password update and
# `make seed`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How access tokens are verified locally. "jwks" for projects on the newer
# asymmetric signing keys (Dashboard -> Settings -> API -> JWT Keys), or
# "hs256" for the legacy shared secret, which then needs SUPABASE_JWT_SECRET.
JWT_VERIFICATION_MODE=jwks
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# Cloudflare R2 (weekly voice recordings)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket
R2_PUBLIC_URL=https://your-public-bucket-domain

# CORS (comma-separated origins for production)
# CORS_ORIGINS=https://admin.mindflow.app,https://app.mindflow.app

# Trusts one reverse-proxy hop by default; set to 0 to trust none.
# TRUST_PROXY_HOPS=1
