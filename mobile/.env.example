# Backend API. Leave unset for local dev — src/config/api.ts already picks the
# right host per platform (10.0.2.2 for Android emulator, localhost for iOS).
# Set this explicitly for a physical device (use your machine's LAN IP) or for
# staging/production.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# DEV-ONLY UI preview: skip login and serve mock API data (no backend needed).
# Only takes effect in development bundles (__DEV__); never set it for EAS/release
# builds. Easiest: `make dev-mobile-preview` from the repo root.
# EXPO_PUBLIC_DEV_AUTH_BYPASS=true
# EXPO_PUBLIC_DEV_GROUP=ex   # ex | cg | unassigned
